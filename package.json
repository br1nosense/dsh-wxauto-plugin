{
  "name": "@dsh-user/dsh-wxauto",
  "version": "0.3.7",
  "description": "DSH 微信自动化插件：任务进度微信推送、消息监听、微信⇄DSH 双向桥（设置页开关+配置）。基于 wxauto4。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/index.d.ts",
    "lib/types/client.d.ts",
    "cordis.patch.yml",
    "skills/",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "install.ps1"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/br1nosense/dsh-wxauto-plugin.git"
  },
  "homepage": "https://github.com/br1nosense/dsh-wxauto-plugin#readme",
  "bugs": {
    "url": "https://github.com/br1nosense/dsh-wxauto-plugin/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "wechat",
    "wxauto",
    "notify",
    "skill"
  ],
  "author": "br1nosense",
  "license": "MIT"
}
